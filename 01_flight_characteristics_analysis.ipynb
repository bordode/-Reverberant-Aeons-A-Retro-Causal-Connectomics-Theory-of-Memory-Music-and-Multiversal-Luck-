      },
      "source": [
        "plt.figure(figsize=(10, 6))\n",
        "sns.scatterplot(x=eval_df['power_gigawatts'], y=eval_df['residuals'], s=100, hue=eval_df['sensor_type'], palette='viridis', alpha=0.8)\n",
        "plt.axhline(y=0, color='red', linestyle='--')\n",
        "\n",
        "plt.title('Residuals vs. Actual Power (Heteroscedasticity Check)', fontsize=14)\n",
        "plt.xlabel('Actual Power (GW)')\n",
        "plt.ylabel('Residuals (Actual - Predicted)')\n",
        "plt.grid(True, linestyle=':', alpha=0.6)\n",
