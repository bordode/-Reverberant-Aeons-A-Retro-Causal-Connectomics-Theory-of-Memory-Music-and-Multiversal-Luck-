        "id": "04e63049"
      },
      "source": [
        "### Distribution of Residuals\n",
        "We plot a histogram with a Kernel Density Estimate (KDE) to check if the residuals are approximately normally distributed."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 436
        },
        "id": "8f66fec7",
        "outputId": "6743046e-60a2-4cdb-f98d-51f0aa14fe5a"
      },
      "source": [
        "plt.figure(figsize=(10, 6))\n",
        "sns.histplot(eval_df['residuals'], kde=True, color='teal', bins=10)\n",
        "\n",
        "plt.title('Distribution of Residual Errors', fontsize=14)\n",
        "plt.xlabel('Residual (Actual - Predicted Power in GW)')\n",
        "plt.ylabel('Frequency')\n",
        "plt.axvline(x=0, color='red', linestyle='--')\n",
        "plt.grid(axis='y', linestyle=':', alpha=0.6)\n",
        "plt.show()\n",
        "\n",
        "# Perform a quick Shapiro-Wilk test for normality\n",
        "from scipy.stats import shapiro\n",
        "stat, p = shapiro(eval_df['residuals'])\n",
        "print(f'Shapiro-Wilk Test: Statistics={stat:.3f}, p-value={p:.3f}')\n",
        "if p > 0.05:\n",
        "    print('Sample looks Gaussian (fail to reject H0)')\n",
        "else:\n",
        "    print('Sample does not look Gaussian (reject H0)')"
      ],
      "execution_count": 24,
      "outputs": [
        {
          "output_type": "display_data",
          "data": {
            "text/plain": [
