        "\n",
        "try:\n",
        "    flight_data = pd.read_csv('uap_flight_data.csv')\n",
        "    flight_data['velocity_ms'] = flight_data['velocity_mach'] * 343\n",
        "    flight_data['kinetic_energy_joules'] = 0.5 * 1000 * (flight_data['velocity_ms'] ** 2)\n",
        "    flight_data['power_gigawatts'] = flight_data['kinetic_energy_joules'] / 1e9\n",
        "\n",
        "    st.subheader(\"Power vs. Velocity\")\n",
        "    fig1 = px.scatter(\n",
        "        flight_data,\n",
        "        x='velocity_mach',\n",
        "        y='power_gigawatts',\n",
        "        size='acceleration_g',\n",
        "        color='anomaly',\n",
        "        hover_data=['date', 'location'],\n",
        "        title='UAP Power vs. Velocity (Size = Acceleration in Gs)'\n",
        "    )\n",
        "    st.plotly_chart(fig1)\n",
        "\n",
        "    st.subheader(\"Propulsion Feasibility\")\n",
        "    propulsion_data = {\n",
        "        \"Mechanism\": [\"Inertial Mass Reduction\", \"Alcubierre Warp Drive\", \"Antimatter Fusion\"],\n",
        "        \"Feasibility\": [7, 5, 9]\n",
        "    }\n",
        "    fig2 = px.bar(propulsion_data, x=\"Mechanism\", y=\"Feasibility\", title=\"Propulsion Feasibility Scores\")\n",
        "    st.plotly_chart(fig2)\n",
        "except Exception as e:\n",
        "    st.error(f\"Error loading data: {e}. Make sure 'uap_flight_data.csv' exists.\")"
