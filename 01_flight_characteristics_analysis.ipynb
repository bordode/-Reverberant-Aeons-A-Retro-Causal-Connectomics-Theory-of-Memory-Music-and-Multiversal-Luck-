      "source": [
        "# UAP Flight Characteristics Analysis\n",
        "# Load and analyze UAP flight data from your uploaded files\n",
        "\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# Load the flight data (already uploaded to Colab)\n",
        "flight_data = pd.read_csv('uap_flight_data.csv')\n",
        "\n",
        "# Display the first few rows\n",
        "print(\"UAP Flight Data:\")\n",
        "print(flight_data.head())\n",
        "\n",
        "# Plot UAP velocities\n",
        "plt.figure(figsize=(10, 6))\n",
        "plt.hist(flight_data['velocity_mach'], bins=10, color='skyblue', edgecolor='black')\n",
        "plt.title('Distribution of UAP Velocities (Mach)')\n",
        "plt.xlabel('Velocity (Mach)')\n",
        "plt.ylabel('Frequency')\n",
        "plt.grid(True)\n",
        "plt.show()\n",
        "\n",
        "# Identify anomalies (acceleration > 100 Gs)\n",
        "anomalies = flight_data[flight_data['acceleration_g'] > 100]\n",
        "print(\"\\nAnomalies (Acceleration > 100 Gs):\")\n",
        "print(anomalies[['date', 'location', 'acceleration_g', 'anomaly']])"
      ],
