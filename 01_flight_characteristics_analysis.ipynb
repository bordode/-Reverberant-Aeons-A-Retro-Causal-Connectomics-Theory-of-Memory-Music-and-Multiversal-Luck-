        "    'Metric': ['R-squared', 'MAE (GW)', 'MAE (%)', 'Mean Power (GW)', 'Sample Size (N)'],\n",
        "    'Value': [0.9738, 0.1177, '7.41%', 1.5885, 23]\n",
        "}\n",
        "perf_df = pd.DataFrame(performance_metrics)\n",
        "\n",
        "print(\"Summary Performance Metrics:\")\n",
        "display(perf_df)\n",
        "\n",
        "# Final Performance Visualization: Actual vs Predicted across all observations\n",
        "plt.figure(figsize=(12, 6))\n",
        "plt.plot(comparison_df.index, comparison_df['power_gigawatts'], label='Actual Power', marker='o', linestyle='-', alpha=0.8)\n",
        "plt.plot(comparison_df.index, comparison_df['predicted_power'], label='Predicted Power', marker='x', linestyle='--', color='red')\n",
        "plt.title('UAP Propulsion Model: Time-Series/Sequence Prediction Accuracy')\n",
