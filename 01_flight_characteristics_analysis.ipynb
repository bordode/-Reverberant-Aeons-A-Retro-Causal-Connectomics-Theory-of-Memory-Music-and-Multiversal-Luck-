        "flight_data['velocity_ms'] = flight_data['velocity_mach'] * 343  # Mach to m/s\n",
        "flight_data['kinetic_energy_joules'] = 0.5 * uap_mass_kg * (flight_data['velocity_ms'] ** 2)\n",
        "flight_data['power_gigawatts'] = flight_data['kinetic_energy_joules'] / 1e9  # GW\n",
        "flight_data['kinetic_energy_TNT_equivalent'] = flight_data['kinetic_energy_joules'] / 4.184e9  # Tons of TNT\n",
        "\n",
        "# --- 2. POWER-TO-WEIGHT RATIO ---\n",
        "flight_data['power_to_weight_ratio'] = flight_data['power_gigawatts'] * 1e9 / uap_mass_kg  # W/kg\n",
        "\n",
        "# --- 3. COMPARISON TO KNOWN SYSTEMS ---\n",
        "power_to_weight = {\n",
        "    \"Human Muscle\": 10,\n",
        "    \"Jet Engine (F-22)\": 10000,\n",
        "    \"Electric Car (Tesla)\": 300,\n",
        "    \"Nuclear Submarine\": 50000,\n",
        "    \"Theoretical Antimatter\": 1e15\n",
        "}\n",
        "\n",
        "for system, ratio in power_to_weight.items():\n",
        "    col_name = f'ratio_to_{system.replace(\" \", \"_\").replace(\"(\", \"\").replace(\")\", \"\")}'\n",
        "    flight_data[col_name] = flight_data['power_to_weight_ratio'] / ratio\n",
        "\n",
        "# --- 4. PROPULSION FEASIBILITY TABLE ---\n",
        "propulsion_data = {\n",
        "    \"Mechanism\": [\n",
        "        \"Inertial Mass Reduction\",\n",
