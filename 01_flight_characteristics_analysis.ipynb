        "        \"High-voltage electromagnetic fields\",\n",
        "        \"Exotic matter (negative energy)\",\n",
        "        \"Zero-point energy\",\n",
        "        \"Fission/fusion\",\n",
        "        \"Antimatter + fusion\",\n",
        "        \"Electromagnetic\"\n",
        "    ],\n",
        "    \"Feasibility (1-10)\": [7, 5, 6, 8, 9, 6],\n",
        "    \"Evidence in Your Data\": [\n",
        "        \"High Gs + no sonic boom\",\n",
        "        \"Transmedium travel\",\n",
        "        \"No exhaust plume\",\n",
        "        \"High power density\",\n",
        "        \"Extreme energy output\",\n",
        "        \"Instant acceleration\"\n",
        "    ]\n",
        "}\n",
        "propulsion_df = pd.DataFrame(propulsion_data)\n",
        "\n",
        "# --- 5. JERK ANALYSIS (HYPOTHETICAL) ---\n",
