      "source": [
        "import numpy as np\n",
        "import pandas as pd\n",
        "\n",
        "# Re-seed for a better distribution\n",
        "np.random.seed(42)\n",
        "\n",
        "# Existing original data\n",
        "original_data = {\n",
        "    'uap_id': [1, 2, 3],\n",
        "    'date': ['2004-11-14', '2015-01-21', '2019-07-15'],\n",
        "    'location': ['Pacific Ocean', 'East Coast USA', 'Atlantic Ocean'],\n",
        "    'velocity_mach': [5.2, 3.8, 4.5],\n",
        "    'acceleration_g': [500, 300, 450],\n",
        "    'sensor_type': ['Radar/FLIR', 'Radar', 'Optical'],\n",
        "    'anomaly': ['Instant acceleration', 'No sonic boom', 'Transmedium travel']\n",
        "}\n",
        "flight_data = pd.DataFrame(original_data)\n",
        "\n",
        "# Force a balanced distribution for the 20 new records to ensure T-test validity\n",
        "sensors = ['Radar/FLIR', 'Radar', 'Optical', 'Satellite']\n",
        "locations = ['Mediterranean Sea', 'Japan Sea', 'North Sea', 'Gulf of Mexico', 'South China Sea', 'Arctic Ocean']\n",
        "anomalies = ['Instant acceleration', 'No sonic boom', 'Transmedium travel', 'Low observability', 'Multi-domain mobility']\n",
        "\n",
        "new_records = []\n",
        "for i in range(4, 24):\n",
        "    v_mach = np.round(np.random.uniform(2.5, 8.0), 1)\n",
        "    v_ms = v_mach * 343\n",
        "    new_records.append({\n",
        "        'uap_id': i,\n",
        "        'date': (pd.to_datetime('2020-01-01') + pd.to_timedelta(np.random.randint(0, 1500), unit='d')),\n",
        "        'location': np.random.choice(locations),\n",
        "        'velocity_mach': v_mach,\n",
        "        'acceleration_g': np.random.randint(100, 800),\n",
        "        'sensor_type': sensors[i % len(sensors)], # Cyclical assignment ensures balanced groups\n",
        "        'anomaly': np.random.choice(anomalies),\n",
        "        'velocity_ms': v_ms,\n",
        "        'power_gigawatts': (0.5 * 1000 * (v_ms ** 2)) / 1e9\n",
        "    })\n",
        "\n",
        "expanded_df = pd.DataFrame(new_records)\n",
        "\n",
        "# Combine and update physics for original rows\n",
        "flight_data['velocity_ms'] = flight_data['velocity_mach'] * 343\n",
        "flight_data['power_gigawatts'] = (0.5 * 1000 * (flight_data['velocity_ms'] ** 2)) / 1e9\n",
        "\n",
        "flight_data = pd.concat([flight_data, expanded_df], ignore_index=True)\n",
        "flight_data.to_csv('uap_flight_data.csv', index=False)\n",
        "\n",
        "print(f\"Balanced dataset created. Total records: {len(flight_data)}\")\n",
        "print(\"Sensor Type Counts:\")\n",
        "print(flight_data['sensor_type'].value_counts())"
      ],
