    {
      "cell_type": "markdown",
      "metadata": {
        "id": "c7d095d6"
      },
      "source": [
        "### T-Test: Power Requirements by Sensor Type\n",
        "We compare the power requirements (GW) of Radar/FLIR detections vs. standalone Radar detections."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "0cb59659",
        "outputId": "7ce7b519-77ab-49af-a1c9-6c2691059502"
      },
      "source": [
        "from scipy.stats import ttest_ind\n",
        "import numpy as np\n",
        "\n",
        "# Group data by sensor type from the newly balanced dataset\n",
        "group1 = flight_data[flight_data['sensor_type'] == 'Radar/FLIR']['power_gigawatts']\n",
        "group2 = flight_data[flight_data['sensor_type'] == 'Radar']['power_gigawatts']\n",
        "\n",
        "# Perform Independent T-test (Welch's T-test due to potential unequal variance)\n",
        "t_stat, p_val = ttest_ind(group1, group2, equal_var=False)\n",
        "\n",
        "print(f\"T-test Results (Radar/FLIR vs Radar):\")\n",
        "print(f\"T-statistic: {t_stat:.4f}\")\n",
        "print(f\"P-value: {p_val:.4f}\")\n",
        "\n",
        "if not np.isnan(p_val) and p_val < 0.05:\n",
        "    print(\"\\nResult: The difference in power requirements is statistically significant.\")\n",
        "else:\n",
        "    print(\"\\nResult: No statistically significant difference found (p >= 0.05).\")\n",
        "\n",
        "# Display summary statistics\n",
        "summary = flight_data.groupby('sensor_type')['power_gigawatts'].agg(['mean', 'std', 'count'])\n",
        "print(\"\\nSummary Statistics by Sensor Type:\")\n",
        "print(summary)"
      ],
      "execution_count": 16,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "T-test Results (Radar/FLIR vs Radar):\n",
            "T-statistic: -0.0197\n",
            "P-value: 0.9847\n",
            "\n",
            "Result: No statistically significant difference found (p >= 0.05).\n",
            "\n",
            "Summary Statistics by Sensor Type:\n",
            "                 mean       std  count\n",
            "sensor_type                           \n",
            "Optical      1.786304  0.987179      6\n",
            "Radar        1.802873  0.951903      6\n",
            "Radar/FLIR   1.792481  0.876129      6\n",
            "Satellite    0.849190  0.464153      5\n"
          ]
        }
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "126c51a6"
      },
      "source": [
        "### One-Way ANOVA: Power Requirements Across All Sensor Types\n",
        "We use ANOVA to test the null hypothesis that all sensor types have the same mean power requirement."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 589
        },
        "id": "75c4d8cd",
        "outputId": "4863e1c6-ae72-4426-8edd-b6dca2ee4314"
      },
      "source": [
        "from scipy.stats import f_oneway\n",
        "\n",
        "# Prepare groups for ANOVA\n",
        "groups = [flight_data[flight_data['sensor_type'] == s]['power_gigawatts'] for s in flight_data['sensor_type'].unique()]\n",
        "\n",
        "# Perform One-Way ANOVA\n",
        "f_stat, p_val_anova = f_oneway(*groups)\n",
        "\n",
        "print(f\"ANOVA Results:\")\n",
        "print(f\"F-statistic: {f_stat:.4f}\")\n",
        "print(f\"P-value: {p_val_anova:.4f}\")\n",
        "\n",
        "if p_val_anova < 0.05:\n",
        "    print(\"\\nResult: Statistically significant differences exist between at least two sensor types.\")\n",
        "else:\n",
        "    print(\"\\nResult: No statistically significant differences found across all sensor types (p >= 0.05).\")\n",
        "\n",
        "# Visualize with a Boxplot\n",
        "import seaborn as sns\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "plt.figure(figsize=(10, 6))\n",
        "sns.boxplot(x='sensor_type', y='power_gigawatts', data=flight_data, palette='Set2')\n",
        "plt.title('Power Requirements by Sensor Type', fontsize=14)\n",
        "plt.ylabel('Power (Gigawatts)')\n",
        "plt.xlabel('Sensor Type')\n",
        "plt.grid(axis='y', linestyle='--', alpha=0.7)\n",
        "plt.show()"
      ],
      "execution_count": 17,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "ANOVA Results:\n",
            "F-statistic: 1.5686\n",
            "P-value: 0.2298\n",
            "\n",
            "Result: No statistically significant differences found across all sensor types (p >= 0.05).\n"
          ]
        },
        {
          "output_type": "stream",
          "name": "stderr",
          "text": [
            "/tmp/ipykernel_2229/2644450707.py:23: FutureWarning: \n",
