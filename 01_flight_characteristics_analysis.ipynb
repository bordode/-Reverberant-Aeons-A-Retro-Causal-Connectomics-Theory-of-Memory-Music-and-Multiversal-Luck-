      "source": [
        "# Grouping by sensor_type and calculating means for key metrics\n",
        "sensor_analysis = flight_data.groupby('sensor_type')[['velocity_mach', 'power_gigawatts']].mean().reset_index()\n",
        "\n",
        "print(\"Mean Velocity and Power by Sensor Type:\")\n",
        "display(sensor_analysis)"
      ],
