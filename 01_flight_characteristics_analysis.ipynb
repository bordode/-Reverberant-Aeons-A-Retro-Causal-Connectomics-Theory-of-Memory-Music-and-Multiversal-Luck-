        "plt.ylabel('Acceleration (G-force)', fontsize=12)\n",
        "plt.grid(True, linestyle='--', alpha=0.6)\n",
        "\n",
        "# Annotate points with location\n",
        "for i in range(flight_data.shape[0]):\n",
        "    plt.text(\n",
