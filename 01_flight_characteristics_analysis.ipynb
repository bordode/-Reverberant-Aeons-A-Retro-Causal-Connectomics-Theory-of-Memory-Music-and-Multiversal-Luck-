    {
      "cell_type": "markdown",
      "metadata": {
        "id": "f1a008a2"
      },
      "source": [
        "### Multivariate Regression Model\n",
        "Predicting `power_gigawatts` using `acceleration_g` and `velocity_mach`."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 328
        },
        "id": "754f180c",
        "outputId": "852d0161-53d7-4ec4-8595-2956ad4f1296"
      },
      "source": [
        "from sklearn.linear_model import LinearRegression\n",
        "from sklearn.metrics import r2_score, mean_squared_error\n",
        "\n",
        "# Define features (X) and target (y)\n",
        "X = flight_data[['acceleration_g', 'velocity_mach']]\n",
        "y = flight_data['power_gigawatts']\n",
        "\n",
        "# Initialize and fit the model\n",
        "model = LinearRegression()\n",
        "model.fit(X, y)\n",
        "\n",
        "# Make predictions\n",
        "y_pred = model.predict(X)\n",
        "\n",
        "# Evaluate the model\n",
        "r2 = r2_score(y, y_pred)\n",
        "mse = mean_squared_error(y, y_pred)\n",
        "\n",
        "print(f\"Multivariate Regression Results:\")\n",
        "print(f\"Intercept: {model.intercept_:.4f}\")\n",
        "print(f\"Coefficients:\")\n",
        "print(f\"  Acceleration (G): {model.coef_[0]:.6f}\")\n",
        "print(f\"  Velocity (Mach): {model.coef_[1]:.6f}\")\n",
        "print(f\"R-squared: {r2:.4f}\")\n",
        "print(f\"Mean Squared Error: {mse:.4f}\")\n",
        "\n",
        "# Display a comparison of actual vs predicted values for the first 5 records\n",
        "comparison_df = flight_data[['uap_id', 'power_gigawatts']].copy()\n",
        "comparison_df['predicted_power'] = y_pred\n",
        "display(comparison_df.head())"
      ],
      "execution_count": 18,
      "outputs": [
