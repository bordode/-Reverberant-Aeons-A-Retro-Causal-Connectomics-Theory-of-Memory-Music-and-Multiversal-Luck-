        }
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "52454a2e"
      },
      "source": [
        "### Model Evaluation: Mean Absolute Error (MAE)\n",
        "Calculating the average magnitude of errors in the set of predictions, without considering their direction."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "605679ff",
        "outputId": "5d9319b5-f0ce-4518-9708-0aeb7947f6d6"
      },
      "source": [
        "from sklearn.metrics import mean_absolute_error\n",
        "\n",
        "# Calculate MAE using actual values (y) and predictions (y_pred)\n",
        "mae = mean_absolute_error(y, y_pred)\n",
        "\n",
        "print(f\"Multivariate Regression - Mean Absolute Error: {mae:.4f} GW\")\n",
        "\n",
        "# Calculate MAE as a percentage of the mean power\n",
        "mean_power = y.mean()\n",
        "mae_percentage = (mae / mean_power) * 100\n",
        "print(f\"MAE as percentage of mean power: {mae_percentage:.2f}%\")"
      ],
      "execution_count": 20,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Multivariate Regression - Mean Absolute Error: 0.1177 GW\n",
            "MAE as percentage of mean power: 7.41%\n"
          ]
        }
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "37ea8ce8"
      },
      "source": [
        "### Model Performance by Sensor Type\n",
        "We can use a faceted plot to see if the multivariate regression model is more or less accurate for specific sensor categories."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 500
        },
        "id": "36631424",
        "outputId": "717900a6-a357-4c87-fd8e-516a1cb8d5ef"
      },
      "source": [
        "import seaborn as sns\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# Combine predictions with sensor metadata\n",
        "eval_df = comparison_df.copy()\n",
        "eval_df['sensor_type'] = flight_data['sensor_type']\n",
        "\n",
        "# Create a faceted scatter plot\n",
        "g = sns.FacetGrid(eval_df, col=\"sensor_type\", col_wrap=2, height=4, aspect=1.2)\n",
        "g.map(sns.scatterplot, \"power_gigawatts\", \"predicted_power\", alpha=0.7, color='teal', s=80)\n",
        "\n",
        "# Add reference lines to each subplot\n",
        "for ax in g.axes.flat:\n",
        "    ax.plot([eval_df['power_gigawatts'].min(), eval_df['power_gigawatts'].max()],\n",
        "            [eval_df['power_gigawatts'].min(), eval_df['power_gigawatts'].max()],\n",
        "            'r--', lw=1, label='Ideal')\n",
        "    ax.set_xlabel('Actual Power (GW)')\n",
        "    ax.set_ylabel('Predicted Power (GW)')\n",
        "\n",
        "g.set_titles(col_template=\"{col_name} Sensor\")\n",
        "g.fig.subplots_adjust(top=0.9)\n",
        "g.fig.suptitle('Actual vs. Predicted Power Grouped by Sensor Type', fontsize=16)\n",
        "plt.show()"
      ],
      "execution_count": 21,
      "outputs": [
        {
          "output_type": "display_data",
          "data": {
            "text/plain": [
              "<Figure size 960x800 with 4 Axes>"
            ],
            "image/png": "\n"
          },
          "metadata": {}
        }
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "195bd052"
      },
      "source": [
        "### Residual Analysis\n",
        "We calculate the residuals ($y - \\hat{y}$) and plot them against the predicted values to ensure the model's errors are homoscedastic and randomly distributed."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 407
        },
        "id": "1d2e922e",
        "outputId": "f47ea238-a5c5-4fc5-e503-9f6590d1bab0"
      },
      "source": [
        "# Calculate residuals\n",
        "eval_df['residuals'] = eval_df['power_gigawatts'] - eval_df['predicted_power']\n",
        "\n",
        "plt.figure(figsize=(10, 6))\n",
        "sns.scatterplot(x=eval_df['predicted_power'], y=eval_df['residuals'], s=100, color='brown', alpha=0.7)\n",
        "plt.axhline(y=0, color='black', linestyle='--')\n",
        "\n",
        "plt.title('Residual Plot: Predicted Power vs. Residuals', fontsize=14)\n",
        "plt.xlabel('Predicted Power (GW)')\n",
        "plt.ylabel('Residuals (Actual - Predicted)')\n",
        "plt.grid(True, linestyle=':', alpha=0.6)\n",
        "plt.show()\n",
        "\n",
        "# Calculate and display the mean of residuals\n",
        "print(f\"Mean of Residuals: {eval_df['residuals'].mean():.4e}\")"
      ],
      "execution_count": 22,
      "outputs": [
        {
          "output_type": "display_data",
          "data": {
            "text/plain": [
              "<Figure size 1000x600 with 1 Axes>"
            ],
            "image/png": "\n"
          },
          "metadata": {}
        },
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Mean of Residuals: 4.2237e-16\n"
          ]
        }
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "51ab6981"
      },
      "source": [
        "### Summary Table of Residual Errors by Sensor Type\n",
        "This table provides a statistical breakdown of the model's prediction errors (residuals) across the different sensor categories."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 227
        },
        "id": "50d4b7b0",
        "outputId": "8d1fab21-5f36-4a47-dae5-ea9ad90dfd6c"
      },
      "source": [
        "# Calculate residual statistics grouped by sensor type\n",
        "residual_summary = eval_df.groupby('sensor_type')['residuals'].agg([\n",
        "    ('Mean Residual', 'mean'),\n",
        "    ('Std Dev of Residual', 'std'),\n",
        "    ('Min Residual', 'min'),\n",
        "    ('Max Residual', 'max'),\n",
        "    ('Count', 'count')\n",
        "]).reset_index()\n",
