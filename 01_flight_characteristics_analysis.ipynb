      "cell_type": "markdown",
      "metadata": {
        "id": "5cc8f185"
      },
      "source": [
        "### Regression Model Visualization: Predicted vs. Actual Power\n",
        "A scatter plot helps visualize the residuals and overall fit of the multivariate model."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 395
        },
        "id": "7a607ee9",
        "outputId": "00c50671-1fa9-4602-f7a9-5c0ed94c8471"
      },
      "source": [
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "import numpy as np\n",
        "\n",
        "plt.figure(figsize=(10, 6))\n",
        "\n",
        "# Plotting Actual vs Predicted\n",
        "sns.scatterplot(x=comparison_df['power_gigawatts'], y=comparison_df['predicted_power'], s=100, alpha=0.7, color='teal')\n",
        "\n",
        "# Adding a reference line (Perfect Prediction)\n",
        "max_val = max(comparison_df['power_gigawatts'].max(), comparison_df['predicted_power'].max())\n",
        "min_val = min(comparison_df['power_gigawatts'].min(), comparison_df['predicted_power'].min())\n",
        "plt.plot([min_val, max_val], [min_val, max_val], color='red', linestyle='--', label='Perfect Prediction Line')\n",
        "\n",
        "plt.title('Actual vs. Predicted UAP Power Requirements', fontsize=14)\n",
        "plt.xlabel('Actual Power (GW)', fontsize=12)\n",
        "plt.ylabel('Predicted Power (GW)', fontsize=12)\n",
        "plt.legend()\n",
        "plt.grid(True, linestyle=':', alpha=0.6)\n",
        "plt.show()"
      ],
      "execution_count": 19,
      "outputs": [
        {
          "output_type": "display_data",
