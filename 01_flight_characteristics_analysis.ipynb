            "image/png": "\n"
          },
          "metadata": {}
        },
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Shapiro-Wilk Test: Statistics=0.854, p-value=0.003\n",
            "Sample does not look Gaussian (reject H0)\n"
          ]
        }
      ]
    },
