        "import seaborn as sns\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# Combine predictions with sensor metadata for visualization\n",
        "plot_df = comparison_df.copy()\n",
        "plot_df['sensor_type'] = flight_data['sensor_type']\n",
        "\n",
        "# Create a faceted scatter plot\n",
        "sns.set_theme(style=\"whitegrid\")\n",
        "g = sns.FacetGrid(plot_df, col=\"sensor_type\", col_wrap=2, height=4, aspect=1.2, hue=\"sensor_type\", palette=\"viridis\")\n",
        "g.map(sns.scatterplot, \"power_gigawatts\", \"predicted_power\", s=100, alpha=0.8, edgecolor='w')\n",
        "\n",
        "# Add a 1:1 reference line for each facet to show ideal performance\n",
        "for ax in g.axes.flat:\n",
        "    min_val = plot_df[['power_gigawatts', 'predicted_power']].min().min()\n",
        "    max_val = plot_df[['power_gigawatts', 'predicted_power']].max().max()\n",
        "    ax.plot([min_val, max_val], [min_val, max_val], color='red', linestyle='--', linewidth=1, label='Ideal Fit')\n",
        "    ax.set_xlabel('Actual Power (GW)')\n",
        "    ax.set_ylabel('Predicted Power (GW)')\n",
        "\n",
        "g.set_titles(col_template=\"{col_name} Sensor Data\")\n",
        "g.fig.subplots_adjust(top=0.9)\n",
        "g.fig.suptitle('Model Performance Accuracy by Sensor Category', fontsize=16)\n",
        "\n",
        "plt.show()"
      ],
